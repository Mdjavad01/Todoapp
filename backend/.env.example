# ============================================================
#  کارام — نمونه‌ی فایل تنظیمات
#  این فایل را با نام .env در پوشه‌ی «private» بیرون از public_html
#  قرار دهید (ساختار در docs/INSTALL.md توضیح داده شده است).
#  هرگز این فایل را در ریپو یا مسیر عمومی نگذارید.
# ============================================================

# --- اپ ---
APP_NAME="کارام"
APP_URL="https://app.hojre24shop.ir"
APP_VERSION="1.0.0"
# محیط اجرا — گام ۱ امنیت: production یا نامشخص = کد OTP هرگز در پاسخ API برنمی‌گردد
# (حتی اگر OTP_DEBUG=1 باشد؛ این پیکربندی ناسازگار در /api/health هشدار داده می‌شود)
# فقط برای توسعه‌ی محلی: APP_ENV="development"
APP_ENV="production"
# مبداهای اضافه‌ی مجاز CORS با کاما (فاز ۶ — اپ اندروید):
# WebView اپ اندروید از مبدأ https://localhost به API درخواست می‌زند
CORS_EXTRA_ORIGINS="https://localhost"

# --- امنیت توکن (فاز ۳) ---
# راز امضای توکن دسترسی و هش کدهای OTP — حتماً تصادفی و طولانی: openssl rand -hex 32
APP_SECRET="CHANGE_ME_openssl_rand_hex_32"
# عمر توکن دسترسی به ساعت (پیش‌فرض ۲۴ ساعت؛ تمدید خودکار با Refresh Token چرخشی)
ACCESS_TOKEN_TTL_HOURS="24"
# عمر توکن رفرش هر دستگاه به روز (پیش‌فرض ۱۸۰ روز)
REFRESH_TOKEN_TTL_DAYS="180"
# عمر نشست پنل مدیریت به ساعت (پیش‌فرض ۱۲ ساعت)
ADMIN_SESSION_TTL_HOURS="12"
# ورود مستقیم بدون کد — فقط برای توسعه‌ی محلی! روی هاست حتماً «0»
OPEN_SESSION="0"

# --- کد یک‌بارمصرف (OTP — فاز ۳) ---
# اعتبار کد به دقیقه
OTP_TTL_MINUTES="5"
# حداقل فاصله بین دو درخواست کد برای یک حساب (ثانیه)
OTP_RESEND_AFTER="60"
# سقف تلاش اشتباه برای هر کد — بعد از آن کد باطل می‌شود
OTP_MAX_ATTEMPTS="5"
# سقف درخواست کد در ساعت: برای هر حساب / برای هر IP
OTP_MAX_PER_HOUR="5"
OTP_MAX_PER_IP_HOUR="20"
# فقط برای تست محلی! کد در پاسخ API هم برمی‌گردد — روی هاست حتماً «0»
# گام ۱: در محیط production (APP_ENV نامشخص یا production) این کلید بی‌اثر است و هشدار می‌دهد
OTP_DEBUG="0"

# --- دیتابیس (MySQL/MariaDB از cPanel) ---
# درایور: mysql برای هاست — sqlite فقط برای توسعه/تست محلی (نیازی به تغییر روی هاست نیست)
DB_DRIVER="mysql"
SQLITE_PATH=""
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="hojre24_karam"
DB_USER="hojre24_karam"
DB_PASS="CHANGE_ME_STRONG_PASSWORD"
DB_CHARSET="utf8mb4"

# --- توکن نصب یک‌بارمصرف (برای setup-admin.php) ---
# بعد از نصب می‌توانید حذفش کنید
SETUP_TOKEN="CHANGE_ME_RANDOM_TOKEN"

# --- ایمیل (فاز ۳ — ارسال OTP) ---
# mail   = تابع mail() خود cPanel (پیش‌فرض روی هاست)
# smtp   = کلاینت SMTP (وقتی mail() کافی نباشد — SMTP_* را پر کنید)
# log    = فقط نوشتن در storage/logs/mail.log (توسعه‌ی محلی — روی هاست استفاده نکنید)
MAIL_TRANSPORT="mail"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="tls"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@hojre24shop.ir"
SMTP_FROM_NAME="کارام"

# --- ربات تلگرام (فاز ۵ — کد تأیید ورود) ---
# توکن را از @BotFather تلگرام بگیرید؛ کاربران باید یک‌بار به ربات پیام دهند.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# فقط برای تست محلی (سرور ساختگی تلگرام) — این خط را روی هاست کلاً حذف کنید یا کامنت بگذارید
# (مقدار خالی مثل TELEGRAM_API_BASE="" در نسخه‌های قبلی باعث خطای «No host part in the URL» می‌شد — الان هم در کد دفاع شده)
# TELEGRAM_API_BASE="https://api.telegram.org"

# --- درگاه زیبال (فاز ۵) ---
# کد مرچنت زیبال (برای تست: zibal)
ZIBAL_MERCHANT=""
# آدرس API فقط برای تست محلی (سرور ساختگی زیبال) — این خط را روی هاست کلاً حذف کنید یا کامنت بگذارید
# ZIBAL_API_BASE="https://gateway.zibal.ir"
ZIBAL_SANDBOX="1"
