# ============================================================
#  کارام — نمونه‌ی فایل تنظیمات
#  این فایل را با نام .env در پوشه‌ی «private» بیرون از public_html
#  قرار دهید (ساختار در docs/INSTALL.md توضیح داده شده است).
#  هرگز این فایل را در ریپو یا مسیر عمومی نگذارید.
# ============================================================

# --- اپ ---
APP_NAME="کارام"
APP_URL="https://app.hojre24shop.ir"
APP_VERSION="1.0.0"

# --- امنیت توکن (فاز ۲) ---
# راز امضای توکن دسترسی — حتماً تصادفی و طولانی: openssl rand -hex 32
APP_SECRET="CHANGE_ME_openssl_rand_hex_32"
# عمر توکن دسترسی به ساعت (پیش‌فرض ۷۲۰ = ۳۰ روز؛ در فاز ۳ با refresh token چرخشی کامل می‌شود)
ACCESS_TOKEN_TTL_HOURS="720"
# فاز ۲: ساخت نشست بدون کد OTP فعال است (ورود فقط با ایمیل).
# در فاز ۳ با راه‌اندازی OTP ایمیل/بله این مقدار حتماً «0» می‌شود.
OPEN_SESSION="1"

# --- دیتابیس (MySQL/MariaDB از cPanel) ---
# درایور: mysql برای هاست — sqlite فقط برای توسعه/تست محلی (نیازی به تغییر روی هاست نیست)
DB_DRIVER="mysql"
SQLITE_PATH=""
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="hojre24_karam"
DB_USER="hojre24_karam"
DB_PASS="CHANGE_ME_STRONG_PASSWORD"
DB_CHARSET="utf8mb4"

# --- توکن نصب یک‌بارمصرف (برای setup-admin.php) ---
# بعد از نصب می‌توانید حذفش کنید
SETUP_TOKEN="CHANGE_ME_RANDOM_TOKEN"

# --- SMTP (فاز ۳ — ارسال OTP ایمیل) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@hojre24shop.ir"
SMTP_FROM_NAME="کارام"

# --- ربات بله (فاز ۳) ---
BALE_BOT_TOKEN=""
BALE_BOT_USERNAME=""
BALE_WEBHOOK_SECRET=""

# --- درگاه زیبال (فاز ۵) ---
ZIBAL_MERCHANT=""
ZIBAL_SANDBOX="1"

# --- درگاه آقای پرداخت (فاز ۵) ---
AQAYEPARDAKHT_MERCHANT=""
AQAYEPARDAKHT_SANDBOX="1"

# --- کارت‌به‌کارت (فاز ۵ — از پنل ادمین هم قابل مدیریت است) ---
CARD_TRANSFER_ENABLED="0"
