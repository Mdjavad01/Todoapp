# پوشه‌ی کد بک‌اند — هیچ دسترسی مستقیم وب
Require all denied

# گام ۱ — صراحتاً: فایل‌های عیب‌یابی و پوشه‌ی نصب هرگز وب نمی‌شوند (دفاع در عمق)
<FilesMatch "^diag[^/]*\.php$">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)install/ - [F,L]
    RewriteRule (^|/)diag[^/]*\.php$ - [F,L]
</IfModule>
