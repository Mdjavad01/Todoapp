# کارام — API (v17: کارایی زیر بار همزمان)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # فقط index.php به‌عنوان entrypoint
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# جلوگیری از دسترسی مستقیم به فایل‌های حساس
<FilesMatch "(\.(env|sql|log|md)|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# هدرهای امنیتی
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    # پاسخ API کش‌شدنی نیست (حتی توسط پراکسی‌ها) — داده‌ی هر کاربر مخصوص خودش است
    Header always set Cache-Control "no-store"
</IfModule>

# فشرده‌سازی پاسخ JSON — با سینک سنگین (هزاران آیتم) حجم انتقال تا ~۸۰٪ کم می‌شود
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json text/html text/plain
</IfModule>

# غیرفعال‌کردن نمای دایرکتوری
Options -Indexes
