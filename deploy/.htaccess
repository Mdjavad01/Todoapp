# ============================================================
#  کارام — .htaccess اصلی روت دامین (public_html)
#  SPA fallback + محافظت فایل‌های حساس + هدرهای امنیتی + CSP سخت‌گیرانه
# ============================================================

Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # گام ۱ — فایل‌های عیب‌یابی و پوشه‌ی نصب: 403 (قبل از هر چیز دیگری)
    RewriteRule (^|/)install/ - [F,L]
    RewriteRule (^|/)diag[^/]*\.php$ - [F,L]

    # اجبار به HTTPS (پس از فعال‌بودن SSL روی هاست)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # مسیر /api از پوشه‌ی api در روت دامین سرو می‌شود (بدون دستکاری)
    # همه‌ی مسیرهای ناشناخته → index.html (SPA)
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.html [L]
</IfModule>

# ---------------- فایل‌های ممنوع ----------------
<FilesMatch "(^\.|\.(env|sql|log|bak|ini|sh)|~)$">
    Require all denied
</FilesMatch>

# گام ۱ — فایل‌های عیب‌یابی (diag*.php) در هر مسیری: 403
<FilesMatch "^diag[^/]*\.php$">
    Require all denied
</FilesMatch>

# ---------------- هدرهای امنیتی ----------------
<IfModule mod_headers.c>
    # CSP سخت‌گیرانه: فقط خود دامین (قانون اینترنت ملی)
    # استثنای وویس‌به‌متن بعداً با دامنه‌ی مشخص سرویس اضافه می‌شود
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # HSTS — فقط وقتی HTTPS کامل شد فعال بماند
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # کش فایل‌های hash‌شده‌ی بیلد
    <FilesMatch "\.(js|css|woff2|png|svg|jpg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # index.html همیشه تازه (برای اعمال آپدیت‌های PWA)
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # sw.js همیشه تازه (تشخیص نسخه‌ی جدید Service Worker)
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType image/svg+xml .svg
