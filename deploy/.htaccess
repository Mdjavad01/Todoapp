# ============================================================
#  کارام — .htaccess اصلی روت دامین (public_html) — v1.12.0
#  SPA fallback + محافظت فایل‌های حساس + هدرهای امنیتی + CSP سخت‌گیرانه
#  + کش یک‌ساله‌ی immutable + فشرده‌سازی (ادغام‌شده با htaccess اپِ سابق —
#  از این نسخه فقط همین یک فایل در ریشه است؛ frontend/public/.htaccess حذف شد)
# ============================================================

Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # گام ۱ — فایل‌های عیب‌یابی و پوشه‌ی نصب: 403 (قبل از هر چیز دیگری)
    RewriteRule (^|/)install/ - [F,L]
    RewriteRule (^|/)diag[^/]*\.php$ - [F,L]

    # اجبار به HTTPS (پس از فعال‌بودن SSL روی هاست)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # مسیر /api از پوشه‌ی api در روت دامین سرو می‌شود (بدون دستکاری)
    # همه‌ی مسیرهای ناشناخته → index.html (SPA)
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.html [L]
</IfModule>

# ---------------- فایل‌های ممنوع ----------------
<FilesMatch "(^\.|\.(env|sql|log|bak|ini|sh)|~)$">
    Require all denied
</FilesMatch>

# گام ۱ — فایل‌های عیب‌یابی (diag*.php) در هر مسیری: 403
<FilesMatch "^diag[^/]*\.php$">
    Require all denied
</FilesMatch>

# ---------------- فشرده‌سازی — حجم انتقال JS/CSS/فونت/JSON تا ~۸۰٪ کم می‌شود ----------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ---------------- کش مرورگر (Expires) ----------------
<IfModule mod_expires.c>
    ExpiresActive On
    # اسکریپت/استایل hash‌دار + فونت‌ها و آیکن‌ها: یک سال، بی‌بازپرسی
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    # صفحه‌ی ورود و مانیفست و سرویس‌ورکر: همیشه تازه تا به‌روزرسانی‌ها فوراً دیده شود
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/manifest+json "access plus 0 seconds"
</IfModule>

# ---------------- هدرهای امنیتی + کش ----------------
<IfModule mod_headers.c>
    # CSP سخت‌گیرانه: فقط خود دامین (قانون اینترنت ملی)
    # استثنای وویس‌به‌متن بعداً با دامنه‌ی مشخص سرویس اضافه می‌شود
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # HSTS — rollout تدریجی (v1.12.0): max-age=300 یعنی مرورگر حداکثر ۵ دقیقه
    # https را به‌خاطر می‌سپارد؛ اگر مشکلی پیش بیاید حداکثر ۵ دقیقه بعد خودش رفع
    # می‌شود. بدون includeSubDomains و بدون preload.
    # ⚠️ بعد از تأیید کامل (اپ وب + پنل + api + صفحات /privacy و /terms چند روز سالم):
    #    همین خط را به "max-age=31536000; includeSubDomains" افزایش دهید (در نصب.txt بخش د)
    Header always set Strict-Transport-Security "max-age=300"

    # immutable = مرورگر حتی If-None-Match هم نمی‌پرسد — صفر درخواست برای assets
    # فایل‌های assets نام hash شده دارند (نام فایل = محتوا) → کش یک‌ساله؛
    # بار دوم باز کردن اپ، هیچ فایلی دوباره دانلود نمی‌شود — حتی با ۲۰۰۰ کاربر همزمان
    <FilesMatch "\-[^/]*\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(woff2|png|svg|jpg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # index.html همیشه تازه (برای اعمال آپدیت‌های PWA)
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # sw.js همیشه تازه (تشخیص نسخه‌ی جدید Service Worker) — وگرنه به‌روزرسانی PWA گیر می‌کند
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType image/svg+xml .svg
